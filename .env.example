# Gifted & Co. Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project settings:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the Project URL and anon public key

# TODO: Replace with your own Supabase project URL
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# TODO: Replace with your own Supabase anonymous key
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ============================================
# PAYSTACK CONFIGURATION
# ============================================
# Get these from your Paystack dashboard:
# 1. Go to https://dashboard.paystack.com/
# 2. Sign up/login to your account
# 3. Go to Settings > API Keys & Webhooks
# 4. Copy your test/public and secret keys
#
# IMPORTANT SECURITY NOTES:
# - NEVER expose the secret key in frontend code
# - Only use public key in frontend applications
# - Secret key should only be used in secure server environments
# - Test keys start with pk_test_ and sk_test_
# - Live keys start with pk_live_ and sk_live_

# Frontend: Safe to expose in client-side code
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Backend/Edge Functions: NEVER expose this in frontend code
# This should only be used in Supabase Edge Functions or server-side code
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================
# VITE_APP_NAME=Gifted & Co.
# VITE_APP_URL=http://localhost:3000
